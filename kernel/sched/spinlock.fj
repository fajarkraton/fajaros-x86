// FajarOS Nova v0.5.2 — Spinlock (Phase 5 of FAJAROS_100PCT_FJ_PLAN)
// Atomic test-and-set via fj-lang `atomic_cas_u64` builtin (Gap G-A
// closure, fajar-lang Phase 5). Replaces V0.5.1 inline-asm CMPXCHG with
// a higher-level atomic primitive that LLVM lowers to the same LOCK
// CMPXCHG instruction (verified by ELF disasm test).
//
// V0.5.0 race (FIXED V0.5.1, simplified V0.5.2):
//   while volatile_read(addr) != 0 {}; volatile_write(addr, 1)
//   → both CPUs could pass the read-check, both write 1, both think
//     they own the lock. Silent until SMP enabled.
//
// V0.5.2 uses fj's atomic_cas_u64(addr, expected=0, new=1):
//   - Returns 0 if we acquired (CAS succeeded)
//   - Returns non-zero if held (CAS failed; prev value returned)
// LLVM emits `lock cmpxchgq` with SeqCst ordering — strongest available.

@kernel fn spinlock_try_acquire(lock_addr: i64) -> i64 {
    // Returns 0 on acquire, non-zero (the previous value) if held.
    atomic_cas_u64(lock_addr, 0, 1)
}

@kernel fn spinlock_acquire(lock_addr: i64) {
    while spinlock_try_acquire(lock_addr) != 0 {
        // PAUSE hint via inline asm (no fj builtin yet for this).
        asm("pause", volatile)
    }
}

@kernel fn spinlock_release(lock_addr: i64) {
    // SeqCst atomic store handles the memory barrier + write atomically.
    atomic_store_u64(lock_addr, 0)
}

@kernel fn cmd_spinlock() {
    cprintln("Spinlock Test (V0.5.1 SMP-correct):", YELLOW_ON_BLACK)
    let lock: i64 = 0x651000  // test lock address
    spinlock_release(lock)  // initialize to 0 atomically
    cprint("  Acquire... ", WHITE_ON_BLACK)
    spinlock_acquire(lock)
    cprintln("OK (locked)", GREEN_ON_BLACK)
    cprint("  Release... ", WHITE_ON_BLACK)
    spinlock_release(lock)
    cprintln("OK (unlocked)", GREEN_ON_BLACK)
    cprint("  Re-acquire (after release)... ", WHITE_ON_BLACK)
    spinlock_acquire(lock)
    cprintln("OK", GREEN_ON_BLACK)
    spinlock_release(lock)
    cprintln("  Spinlock verified (LOCK CMPXCHG path).", GREEN_ON_BLACK)
}
