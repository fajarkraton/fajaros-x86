// Raw lookup — assumes 0 <= idx < 1572.
// SAFETY: caller must clamp idx; out-of-range read into adjacent .rodata.
@naked @unsafe fn rope_sin_lut_raw(idx: i64) -> i64 {
    asm!("xor %rax, %rax\n\tleaq rope_sin_lut_v33(%rip), %rcx\n\tmovzwl (%rcx, %rdi, 2), %eax\n\tret", options(att_syntax))
}

// Bounds-checked LUT lookup matching c_rope_sin_q1 semantics.
@kernel fn km_rope_sin_q1(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= 1572 { return 10000 }
    rope_sin_lut_raw(x)
}

// Quadrant-resolving sin matching c_rope_sin semantics.
// angle is mrad (×1000 of radians); modulo 6283 = 2π.
@kernel fn km_rope_sin(angle: i64) -> i64 {
    let two_pi: i64 = 6283
    let pi: i64 = 3142
    let hpi: i64 = pi / 2
    let raw = angle % two_pi
    let a = if raw < 0 { raw + two_pi } else { raw }
    if a <= hpi { return km_rope_sin_q1(a) }
    if a <= pi { return km_rope_sin_q1(pi - a) }
    if a <= pi + hpi { return -km_rope_sin_q1(a - pi) }
    -km_rope_sin_q1(two_pi - a)
}

@kernel fn km_rope_cos(angle: i64) -> i64 {
    km_rope_sin(angle + 1571)
}
